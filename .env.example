# From console.cloud.google.com -> APIs & Services -> Credentials
# Enable "Google Calendar API" first, then create an OAuth client ID (Web app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any random long string, e.g. output of: openssl rand -base64 32
NEXTAUTH_SECRET=

# http://localhost:3000 for local dev, your real domain in production
NEXTAUTH_URL=http://localhost:3000

# From supabase.com -> New project (free tier) -> Settings -> API
# Run the SQL comment at the top of lib/supabase.js once to create the table
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Any password you make up — protects the /admin stats page
ADMIN_SECRET=
